      <span id="pp-status"></span>
      <span>P = show/hide</span>
    </div>`;

  document.body.appendChild(panel);
  canvas=panel.querySelector('#pp-map');
  ctx=canvas.getContext('2d');
  topBox=panel.querySelector('#pp-top');
  serverBtn=panel.querySelector('#pp-server');
  statusBox=panel.querySelector('#pp-status');

  serverBtn.onclick=()=>{
    const i=SERVERS.indexOf(uiState.server);
    uiState.server=SERVERS[(i+1)%SERVERS.length];
    saveUi(); render();
  };
  panel.querySelector('#pp-hide').onclick=()=>{
    uiState.hidden=true; saveUi(); render();
  };

  canvas.addEventListener('mousemove',e=>{
    const r=canvas.getBoundingClientRect();
    const x=Math.floor((e.clientX-r.left)/r.width*32);
    const y=Math.floor((e.clientY-r.top)/r.height*32);
    canvas.title=`(${x},${y}) score=${score(activeServer(),`${x},${y}`).toFixed(1)}`;
  });

  // Drag panel by header
  const head=panel.querySelector('.head');
  head.addEventListener('mousedown',e=>{
    if(e.target.tagName==='BUTTON') return;
    const r=panel.getBoundingClientRect();
    drag={dx:e.clientX-r.left,dy:e.clientY-r.top};
    e.preventDefault();
  });
  window.addEventListener('mousemove',e=>{
    if(!drag) return;
    panel.style.left=Math.max(0,e.clientX-drag.dx)+'px';
    panel.style.top=Math.max(0,e.clientY-drag.dy)+'px';
    panel.style.right='auto'; panel.style.bottom='auto';
  });
  window.addEventListener('mouseup',()=>drag=null);

  render();
}

function boot() {
  uiState.hidden = false;
  saveUi();
  mount();
  parseText(document.body?.innerText || '');

  const mo=new MutationObserver(ms=>{
    for(const m of ms) for(const n of m.addedNodes) {
      if(n.nodeType===Node.TEXT_NODE) parseText(n.nodeValue);
      else if(n.nodeType===Node.ELEMENT_NODE) parseText(n.innerText || n.textContent);
    }
  });
  mo.observe(document.documentElement,{subtree:true,childList:true});

  setInterval(()=>{
    const s=guessServer();
    if(s && s!==detectedServer) detectedServer=s;
    render();
  },1500);

  document.addEventListener('keydown',e=>{
    const t=e.target;
    if(t && (t.tagName==='INPUT'||t.tagName==='TEXTAREA'||t.isContentEditable)) return;
    if(e.key.toLowerCase()==='p' && !e.repeat) {
      uiState.hidden=!uiState.hidden; saveUi(); render();
    }
  },true);
}

if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot,{once:true});
else boot();

window.PlutoOverlay={
  top:(n=10)=>ranked(n),
  record,
  export:()=>JSON.stringify(live,null,2),
  reset:()=>{live={};saveLive();render();},
  show:()=>{uiState.hidden=false;saveUi();render();},
  hide:()=>{uiState.hidden=true;saveUi();render();}
};
})();
